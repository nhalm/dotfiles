{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-margin-top": 11,
  "control-center-margin-bottom": 0,
  "control-center-margin-right": 3,
  "control-center-margin-left": 0,
  "notification-2fa-action": true,
  "notification-inline-replies": true,
  "notification-icon-size": 48,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "notification-window-width": 400,
  "timeout": 5,
  "timeout-low": 3,
  "timeout-critical": 8,
  "fit-to-screen": false,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": true,
  "hide-on-action": true,
  "script-fail-notify": true,
  "widgets": [
    "dnd",
    "buttons-grid",
    "title",
    "mpris",
    "notifications"
  ],
  "widget-config": {
    "dnd": {
      "text": "Do not disturb"
    },
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear"
    },
    "mpris": {
      "image-size": 88,
      "image-radius": 10
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "\uf1eb",
          "type": "toggle",
          "active": true,
          "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && nmcli radio wifi on || nmcli radio wifi off'",
          "update-command": "sh -c '[[ $(nmcli r wifi) == \"enabled\" ]] && echo true || echo false'"
        },
        {
          "label": "\uf294",
          "type": "toggle",
          "active": true,
          "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && { rfkill unblock bluetooth; bluetoothctl power on; } || bluetoothctl power off'",
          "update-command": "sh -c 'rfkill list bluetooth | grep -q \"Soft blocked: yes\" && echo false || { bluetoothctl show | grep -q \"Powered: yes\" && echo true || echo false; }'"
        },
        {
          "label": "\udb81\udd7e",
          "type": "toggle",
          "active": true,
          "command": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
          "update-command": "sh -c 'wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q MUTED && echo false || echo true'"
        },
        {
          "label": "\uf023",
          "command": "loginctl lock-session"
        }
      ]
    }
  },
  "control-center-width": 400,
  "control-center-height": 700
}
