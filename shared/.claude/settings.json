{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
  },
  "permissions": {
    "allow": [
      "Bash(go fmt:*)",
      "Bash(go doc:*)",
      "Bash(go vet:*)",
      "Bash(go test:*)",
      "Bash(go build:*)",
      "Bash(go run:*)",
      "Bash(go list:*)",
      "Bash(golangci-lint:*)",
      "Bash(gofmt:*)",
      "Bash(make:*)",
      "Bash(black:*)",
      "Bash(ruff:*)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(pip install:*)",
      "WebSearch",
      "WebFetch",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(cat:*)",
      "Read(/Users/nhalm/.claude/**)",
      "Write(/Users/nhalm/.claude/**)",
      "Read(/home/nick/.claude/**)",
      "Write(/home/nick/.claude/**)"
    ],
    "deny": [
      "Read(~/.ssh/id_*)",
      "Read(~/.ssh/*_rsa)",
      "Read(~/.ssh/*_ed25519)",
      "Read(~/.ssh/*_ecdsa)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/op/**)",
      "Read(~/.1password/**)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.netrc)",
      "Read(~/.pgpass)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/config)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Bash(cat ~/.ssh/id_*)",
      "Bash(cat ~/.gnupg/*)",
      "Bash(cat ~/.aws/*)",
      "Write(~/.ssh/**)",
      "Write(~/.gnupg/**)",
      "Write(**/.git/hooks/**)",
      "Edit(**/.git/hooks/**)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf /etc:*)",
      "Bash(rm -rf /usr:*)",
      "Bash(rm -rf /var:*)",
      "Bash(rm -rf /boot:*)",
      "Bash(rm -rf /home:*)",
      "Bash(mkfs:*)",
      "Bash(mkfs.ext4:*)",
      "Bash(mkfs.btrfs:*)",
      "Bash(dd of=/dev/:*)",
      "Bash(wipefs:*)",
      "Bash(cryptsetup luksFormat:*)",
      "Bash(shred:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "ccstatusline",
    "padding": 0
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "effortLevel": "high",
  "autoUpdatesChannel": "latest",
  "minimumVersion": "2.1.42",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "autoCompactEnabled": false
}
