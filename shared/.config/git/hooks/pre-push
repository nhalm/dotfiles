#!/usr/bin/env bash
set -euo pipefail

# core.hooksPath replaces .git/hooks, so run the repo's own pre-push (e.g. a
# force-push guardrail) if it has one. Git feeds refs on stdin; pass it through.
repo_hook="$(git rev-parse --path-format=absolute --git-common-dir)/hooks/pre-push"
if [ -x "$repo_hook" ] && ! [ "$repo_hook" -ef "${BASH_SOURCE[0]}" ]; then
	exec "$repo_hook" "$@"
fi
