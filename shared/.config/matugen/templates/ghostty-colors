# ANSI 1 and 2 are error and tertiary, so red and green follow the wallpaper's
# hues rather than staying red and green. Diffs and log levels read as tints of
# the palette, not as their usual colours.
background = {{colors.surface_container.dark.hex}}
foreground = {{colors.on_surface.dark.hex}}
cursor-color = {{colors.primary.dark.hex}}
selection-background = {{colors.primary_container.dark.hex}}
selection-foreground = {{colors.on_primary_container.dark.hex}}

palette = 0={{colors.surface_container_lowest.dark.hex}}
palette = 1={{colors.error.dark.hex}}
palette = 2={{colors.tertiary.dark.hex}}
palette = 3={{colors.secondary.dark.hex}}
palette = 4={{colors.primary.dark.hex}}
palette = 5={{colors.on_tertiary_container.dark.hex}}
palette = 6={{colors.on_secondary_container.dark.hex}}
palette = 7={{colors.on_surface_variant.dark.hex}}
palette = 8={{colors.outline.dark.hex}}
palette = 9={{colors.on_error_container.dark.hex}}
palette = 10={{colors.tertiary_fixed_dim.dark.hex}}
palette = 11={{colors.secondary_fixed_dim.dark.hex}}
palette = 12={{colors.primary_fixed_dim.dark.hex}}
palette = 13={{colors.tertiary_fixed.dark.hex}}
palette = 14={{colors.secondary_fixed.dark.hex}}
palette = 15={{colors.on_surface.dark.hex}}
