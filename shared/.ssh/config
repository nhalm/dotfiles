Include ~/.ssh/config.local
# IdentityAgent, whose socket path differs per OS. Included before the Host *
# block below because ssh_config takes the first value it sees for a keyword.
Include ~/.ssh/config.os

Host *
	HashKnownHosts yes
	ForwardAgent no
	ForwardX11 no
	ForwardX11Trusted no
	StrictHostKeyChecking ask
	ServerAliveInterval 60
	ServerAliveCountMax 3
	PermitLocalCommand no
