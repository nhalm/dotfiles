# SSH client defaults.
#
# Host-specific entries do NOT belong here -- this repo is public, and internal
# hostnames should not be in it. Put them in ~/.ssh/config.local, which is
# included first: ssh takes the *first* value it obtains for each keyword, so
# anything set there wins over the defaults below.
Include ~/.ssh/config.local

Host *
	# Keys live in 1Password, never on disk. The agent serves them.
	IdentityAgent ~/.1password/agent.sock

	# Store hostnames hashed, so a readable known_hosts doesn't enumerate
	# every host this machine has reached.
	HashKnownHosts yes

	# Never hand the agent to a remote host: anyone with root there could use
	# it to authenticate as you elsewhere, for as long as the session lives.
	ForwardAgent no
	ForwardX11 no
	ForwardX11Trusted no

	# Refuse to continue if a known host's key changes, rather than prompting.
	StrictHostKeyChecking ask

	# Drop dead connections rather than hanging a terminal indefinitely.
	ServerAliveInterval 60
	ServerAliveCountMax 3

	# Do not let a remote host set arbitrary environment variables.
	PermitLocalCommand no
