.netrwhist
.ruby-version

# Files moved aside by stow_package when a real file already occupied a target
*.dotfiles-backup



# Per-machine shell overrides, sourced by .zshrc if present
.config/zsh/local.zsh

# lazy.nvim rewrites this on every plugin update, and the churn is not worth
# reviewing -- a fresh machine resolves plugin versions at install time instead
shared/.config/nvim/lazy-lock.json

# Generated beside the configs that consume them, never tracked
.config/gtk-3.0/colors.css
.config/gtk-4.0/colors.css
.config/gtk-3.0/settings.ini
.config/gtk-4.0/settings.ini
.config/swaync/colors.css
.config/sketchybar/matugen-colors.lua
